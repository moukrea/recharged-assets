{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moukrea/recharged-assets/schemas/manifest.schema.json",
  "title": "Recharged assets manifest (schema v1)",
  "description": "Complete description of one content release (asset_version). The manifest is the full current state even when shards live in older immutable releases.",
  "type": "object",
  "required": ["schema_version", "asset_version", "games", "engine_compat", "profiles", "presets", "shards"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "asset_version": { "type": "string", "pattern": "^assets-v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "games": { "type": "array", "items": { "enum": ["jak1", "jak2", "jak3"] }, "minItems": 1 },
    "engine_compat": {
      "type": "object",
      "required": ["min_recharged_version", "min_loader_version"],
      "additionalProperties": false,
      "properties": {
        "min_recharged_version": { "type": "string" },
        "max_recharged_version": { "type": ["string", "null"], "default": null },
        "min_loader_version": { "type": "integer", "minimum": 1, "description": "Minimum KTX2/RPACK loader version in the binary" },
        "required_features": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Engine features a shard group may require (e.g. material-map shards require 'pbr'); see shards[].requires_features"
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["pc-bc", "pc-bc-legacy", "android-etc2", "android-astc", "rgba8-fallback"] }
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["low", "default", "bonkers"] },
      "description": "very-low is engine-side (no pack installed), never a built artifact"
    },
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "game", "profile", "preset", "group", "cluster", "sha256", "size", "url", "entry_count"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^jak[123]-[a-z0-9-]+-shard-[a-z0-9-]+-[0-9a-f]{12}\\.rpack$" },
          "game": { "enum": ["jak1", "jak2", "jak3"] },
          "profile": { "enum": ["pc-bc", "pc-bc-legacy", "android-etc2", "android-astc", "rgba8-fallback"] },
          "preset": { "enum": ["low", "default", "bonkers"] },
          "group": { "enum": ["albedo", "material"] },
          "cluster": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 1 },
          "url": { "type": "string", "format": "uri", "description": "Immutable GitHub release asset URL (may point to an earlier release than this manifest's)" },
          "release_tag": { "type": "string" },
          "entry_count": { "type": "integer", "minimum": 1 },
          "requires_features": { "type": "array", "items": { "type": "string" }, "description": "e.g. ['pbr'] on material-map shards — the asset manager skips shards the binary can't consume" }
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance_url": { "type": "string", "format": "uri" },
        "manifest_sha256_signed_by": { "type": "string" }
      }
    },
    "notes": { "type": "string" }
  }
}
